            "name": "tenure_band_order",
            "dataType": "int64",
            "sourceColumn": "tenure_band_order",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "measures": [
          {
            "name": "Customer count",
            "expression": "COALESCE(COUNTROWS('Customers'), 0)",
            "formatString": "#,0"
          },
          {
            "name": "Churned customers",
            "expression": "COALESCE(CALCULATE(COUNTROWS('Customers'), KEEPFILTERS('Customers'[Churn] = \"Yes\")), 0)",
            "formatString": "#,0"
          },
          {
            "name": "Observed churn rate",
            "expression": "DIVIDE([Churned customers], [Customer count])",
            "formatString": "0.00%"
          },
          {
            "name": "Average monthly charge",
            "expression": "AVERAGE('Customers'[MonthlyCharges])",
            "formatString": "0.00"
          },
          {
            "name": "Average tenure",
            "expression": "AVERAGE('Customers'[tenure])",
            "formatString": "0.0"
          },
          {
            "name": "Internet customers",
            "expression": "CALCULATE([Customer count], KEEPFILTERS('Customers'[InternetService] <> \"No\"))",
            "formatString": "#,0"
          },
          {
            "name": "Internet churned",
            "expression": "CALCULATE([Churned customers], KEEPFILTERS('Customers'[InternetService] <> \"No\"))",
            "formatString": "#,0"
          },
          {
            "name": "Internet churn rate",
            "expression": "DIVIDE([Internet churned], [Internet customers])",
            "formatString": "0.00%"
          },
          {
            "name": "Small group note",
            "expression": "IF([Customer count] < 30, \"n < 30: interpret cautiously\", \"\")"
          },
          {
            "name": "Internet average monthly charge",
            "expression": "CALCULATE(AVERAGE('Customers'[MonthlyCharges]), KEEPFILTERS('Customers'[InternetService] <> \"No\"))",
            "formatString": "0.00"
          }
        ],
        "partitions": [
          {
            "name": "Customers",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Source = Table.FromRows(Rows, {\"gender\", \"SeniorCitizen\", \"Partner\", \"Dependents\", \"tenure\", \"PhoneService\", \"MultipleLines\", \"InternetService\", \"OnlineSecurity\", \"OnlineBackup\", \"DeviceProtection\", \"TechSupport\", \"StreamingTV\", \"StreamingMovies\", \"Contract\", \"PaperlessBilling\", \"PaymentMethod\", \"MonthlyCharges\", \"Churn\", \"service_count\", \"tenure_band\", \"fee_quartile\", \"has_internet\", \"fee_level\", \"service_level\", \"manual_payment\", \"risk_rule\", \"combination\", \"tenure_band_order\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"gender\", type text}, {\"SeniorCitizen\", Int64.Type}, {\"Partner\", type text}, {\"Dependents\", type text}, {\"tenure\", Int64.Type}, {\"PhoneService\", type text}, {\"MultipleLines\", type text}, {\"InternetService\", type text}, {\"OnlineSecurity\", type text}, {\"OnlineBackup\", type text}, {\"DeviceProtection\", type text}, {\"TechSupport\", type text}, {\"StreamingTV\", type text}, {\"StreamingMovies\", type text}, {\"Contract\", type text}, {\"PaperlessBilling\", type text}, {\"PaymentMethod\", type text}, {\"MonthlyCharges\", type number}, {\"Churn\", type text}, {\"service_count\", Int64.Type}, {\"tenure_band\", type text}, {\"fee_quartile\", type text}, {\"has_internet\", type text}, {\"fee_level\", type text}, {\"service_level\", type text}, {\"manual_payment\", type text}, {\"risk_rule\", type text}, {\"combination\", type text}, {\"tenure_band_order\", Int64.Type})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Customers\"]"
      }
    ]
  }
}

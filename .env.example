# setup_environment.ps1 creates .env automatically. For manual setup, copy this
# file to .env and replace <PROJECT_ROOT> with the absolute project path.
JAVA_HOME=<PROJECT_ROOT>\.tools\jdk-17
PYSPARK_PYTHON=<PROJECT_ROOT>\.venv\Scripts\python.exe
PYSPARK_DRIVER_PYTHON=<PROJECT_ROOT>\.venv\Scripts\python.exe
